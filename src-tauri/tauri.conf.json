{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quickbar",
  "version": "0.1.1",
  "identifier": "com.quickbar.app",
  "build": {
    "beforeDevCommand": "npm run test && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run test && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Quickbar",
        "width": 720,
        "height": 390,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "backgroundColor": "#00000000",
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../plugins": "plugins/",
      "../market": "market/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
